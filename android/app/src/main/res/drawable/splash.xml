<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen splash: the 200dp branded logo centered on SACCO green.
     The launch window background (styles.xml) and the drawable the
     @capacitor/splash-screen plugin shows (androidSplashResourceName "splash").
     Android 12+ shows its system splash instead — see splash_icon in styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#15803d"/>
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo"
            android:tileMode="disabled"/>
    </item>
</layer-list>
